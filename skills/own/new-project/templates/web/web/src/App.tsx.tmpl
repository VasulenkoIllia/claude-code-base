import { useEffect, useState } from "react";

type ApiState = { kind: "loading" } | { kind: "ok" } | { kind: "error"; message: string };

export function App() {
  const [api, setApi] = useState<ApiState>({ kind: "loading" });

  useEffect(() => {
    const controller = new AbortController();
    fetch("/health", { signal: controller.signal })
      .then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        setApi({ kind: "ok" });
      })
      .catch((error: unknown) => {
        if (controller.signal.aborted) return;
        setApi({ kind: "error", message: error instanceof Error ? error.message : String(error) });
      });
    return () => controller.abort();
  }, []);

  return (
    <main className="page">
      <h1>{{name}}</h1>
      {api.kind === "loading" && <p>Перевіряю API...</p>}
      {api.kind === "ok" && <p>API працює.</p>}
      {api.kind === "error" && <p role="alert">API недоступний: {api.message}</p>}
    </main>
  );
}
