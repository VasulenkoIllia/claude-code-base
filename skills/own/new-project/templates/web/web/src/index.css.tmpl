*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100dvh;
  font-family: system-ui, sans-serif;
  line-height: 1.5;
}

/* 16px and up: iOS zooms into smaller inputs */
input,
select,
textarea,
button {
  font: inherit;
  font-size: max(16px, 1rem);
}

.page {
  max-width: 960px;
  margin: 0 auto;
  padding: 16px;
}
