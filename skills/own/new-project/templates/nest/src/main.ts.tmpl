import { ConsoleLogger, filterLogLevels, type LogLevel } from "@nestjs/common";
import { NestFactory } from "@nestjs/core";
import type { NestFastifyApplication } from "@nestjs/platform-fastify";
import { AppModule } from "./app.module.js";
import { config } from "./config.js";
import { APP_OPTIONS, createAdapter } from "./http.js";

// Below stop_grace_period in docker-compose.yml, so the app exits on its own before Docker kills it
const SHUTDOWN_TIMEOUT_MS = 10_000;
const IDLE_SWEEP_MS = 500;
// LOG_LEVEL takes pino's level names, as in the other types (Fastify logs with them); Nest calls info "log" and
// trace "verbose"
const LOG_LEVELS = ["fatal", "error", "warn", "info", "debug", "trace", "silent"];
const NEST_LEVELS = new Map([["info", "log"], ["trace", "verbose"]]);

function nestLevels(level: string): LogLevel[] {
  if (!LOG_LEVELS.includes(level)) {
    throw new Error(`LOG_LEVEL must be one of ${LOG_LEVELS.join(", ")}, got "${level}"`);
  }
  return level === "silent" ? [] : filterLogLevels(`>=${NEST_LEVELS.get(level) ?? level}`);
}

const level = config.logLevel.toLowerCase();
// One JSON line per event; an error keeps its stack, cause and code
const logger = new ConsoleLogger({ json: true, logLevels: nestLevels(level) });
const app = await NestFactory.create<NestFastifyApplication>(AppModule, createAdapter(level), { ...APP_OPTIONS, logger });

async function shutdown(signal: string): Promise<void> {
  logger.log(`shutting down (${signal})`, "Main");
  setTimeout(() => {
    logger.error("shutdown timed out, forcing exit", "Main");
    process.exit(1);
  }, SHUTDOWN_TIMEOUT_MS).unref();
  // A keep-alive connection that goes idle during close would hold it open until its timeout
  const { server } = app.getHttpAdapter().getInstance();
  const sweep = setInterval(() => server.closeIdleConnections(), IDLE_SWEEP_MS);
  // Also runs the shutdown hooks of the modules, after the server has stopped taking requests
  await app.close();
  clearInterval(sweep);
  process.exit(0);
}

// Not app.enableShutdownHooks(): it sends the signal again after closing, and the exit code becomes 143.
// process.on with a flag, not once: Ctrl+C in pnpm run dev also brings a second SIGINT from the Nest CLI, which
// would kill the app halfway through closing.
let isShuttingDown = false;
for (const signal of ["SIGTERM", "SIGINT"] as const) {
  process.on(signal, () => {
    if (isShuttingDown) return;
    isShuttingDown = true;
    shutdown(signal).catch((error: unknown) => {
      logger.error(error, "Main");
      process.exit(1);
    });
  });
}

await app.listen({ host: config.host, port: config.port });
