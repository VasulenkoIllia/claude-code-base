# Copy to .env and fill in. .env is never committed; keep it private (chmod 600 on the server).
TZ=Europe/Kyiv
{{#http}}
LOG_LEVEL=info
PORT=3000

# Production behind Traefik (docker-compose.yml)
APP_NAME={{name}}
APP_DOMAIN=app.example.com
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=cf
{{/http}}
{{#integration}}
# Cron pattern (croner), evaluated in TZ
CRON_SCHEDULE=0 * * * *
{{/integration}}
{{#bot}}
# From @BotFather; one running instance per token
BOT_TOKEN=
{{/bot}}
{{#db}}

# Postgres for docker-compose.yml and docker-compose.dev.yml. Password: letters and digits only (it goes into a URL),
# e.g. from `openssl rand -hex 24`
POSTGRES_DB={{db_name}}
POSTGRES_USER={{db_name}}
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Local development only: <POSTGRES_PASSWORD> is the same password as above, the port is POSTGRES_PORT.
# In Docker the app gets DATABASE_URL from docker-compose.yml.
DATABASE_URL=postgresql://{{db_name}}:<POSTGRES_PASSWORD>@127.0.0.1:5432/{{db_name}}
{{/db}}
{{#budget}}

# Spending limit of paid APIs in USD at list prices per calendar day of one process, so a restart starts it again;
# a call that would pass it is not made. 0: no paid calls
PAID_API_BUDGET_USD=1
{{/budget}}
