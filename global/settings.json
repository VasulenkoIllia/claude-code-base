{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "cleanupPeriodDays": 180,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "GIT_CONFIG_COUNT": "2",
    "GIT_CONFIG_KEY_0": "hook.commit-leaks.event",
    "GIT_CONFIG_VALUE_0": "pre-commit",
    "GIT_CONFIG_KEY_1": "hook.commit-leaks.command",
    "GIT_CONFIG_VALUE_1": "test -x \"$HOME\"/.claude/hooks/commit-leaks.sh && exec \"$HOME\"/.claude/hooks/commit-leaks.sh; echo 'commit-leaks: secrets in this commit are not checked (no hook file)' >&2"
  },
  "skillOverrides": {
    "database-migrations": "name-only",
    "security-review": "name-only"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run verify:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm exec turbo run:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx prettier --check:*)",
      "Bash(npx eslint:*)",
      "Bash(docker ps:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker logs:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(lsof -iTCP:*)",
      "Bash(osv-scanner scan:*)",
      "WebSearch",
      "Bash(~/bin/claude-time)",
      "Bash(~/bin/claude-time --write)",
      "Bash(~/bin/claude-time --pending:*)",
      "Bash(~/bin/claude-time --help)",
      "Bash(~/bin/claude-time --prompts:*)",
      "Bash(~/bin/claude-time --by:*)",
      "Bash(~/bin/claude-metrics)",
      "Bash(~/bin/claude-metrics:*)",
      "Bash(~/bin/claude-time --add:*)",
      "Bash(~/bin/claude-time --split-done:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)",
      "Bash(gh pr merge:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(gh repo create --public*)",
      "Bash(gh repo create * --public*)",
      "Bash(gh repo edit --visibility*)",
      "Bash(gh repo edit * --visibility*)",
      "mcp__terminal__run_in_terminal",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx prisma db push:*)",
      "Edit(~/.claude/CLAUDE.md)",
      "Write(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/settings.json)",
      "Write(~/.claude/settings.json)",
      "Edit(~/.claude/hooks/**)",
      "Write(~/.claude/hooks/**)",
      "Edit(~/.claude/skills/**)",
      "Write(~/.claude/skills/**)",
      "Edit(~/.claude/agents/**)",
      "Write(~/.claude/agents/**)",
      "Edit(~/.claude/rules/**)",
      "Write(~/.claude/rules/**)",
      "Edit(~/.claude/ECC-PIN.md)",
      "Write(~/.claude/ECC-PIN.md)",
      "Edit(~/bin/**)",
      "Write(~/bin/**)",
      "Bash(*claude-time*--ho*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(osv-scanner fix:*)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.server)",
      "Read(//**/.env.deploy)",
      "Read(//**/.env.prod)",
      "Read(//**/.env.github.secrets)",
      "Read(//**/.env.production.bak*)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.stage)",
      "Read(//**/.env.development)",
      "Read(//**/.env.dev)",
      "Read(//**/.env.test)",
      "Read(//**/*.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.codex/auth.json)",
      "Read(~/.gemini/oauth_creds.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/nvm-env.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/node-std.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/session-hint.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/secret-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/bash-guard.sh",
            "timeout": 15,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/push-allow.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/dup-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/doc-reminder.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/session-hint.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/doc-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
